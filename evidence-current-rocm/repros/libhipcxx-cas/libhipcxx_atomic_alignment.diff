+// atomic_ref<T> requires its referent to be aligned to sizeof(T), but T itself may be less aligned
+// (e.g. `struct { int a, b; }`). The __hip_atomic_* builtins take the alignment of the operation
+// from the pointee type, and the AMDGPU backend rejects an under-aligned 8-byte cmpxchg/store
+// ("unsupported cmpxchg"). View the object through a type carrying the required alignment.
+template <class _Type>
+struct __hip_atomic_aligned
+{
+  static constexpr ::cuda::std::size_t __align =
+    ((sizeof(_Type) & (sizeof(_Type) - 1)) == 0 && sizeof(_Type) > alignof(_Type)) ? sizeof(_Type) : alignof(_Type);
+  typedef _Type __attribute__((aligned(__align))) type;
+};
+
+template <class _Type>
+static inline _CCCL_DEVICE volatile typename __hip_atomic_aligned<_Type>::type* __hip_atomic_aligned_ptr(volatile _Type* __ptr) {
+    return reinterpret_cast<volatile typename __hip_atomic_aligned<_Type>::type*>(__ptr);
+}
+
+template <class _Type>
+static inline _CCCL_DEVICE const volatile typename __hip_atomic_aligned<_Type>::type* __hip_atomic_aligned_ptr(const volatile _Type* __ptr) {
+    return reinterpret_cast<const volatile typename __hip_atomic_aligned<_Type>::type*>(__ptr);
+}
+
+template <class _Type>
+static inline _CCCL_DEVICE typename __hip_atomic_aligned<_Type>::type* __hip_atomic_aligned_ptr(_Type* __ptr) {
+    return reinterpret_cast<typename __hip_atomic_aligned<_Type>::type*>(__ptr);
+}
